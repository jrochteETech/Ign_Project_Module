          "script": "\tsvc \u003d self.view.custom\n\t\n\ttry:\n\t\ttags\u003dsystem.tag.browse(filter\u003d{\"tagType\":\"Provider\"}).results\n\t\t\n\t\tproviderList \u003d []\n\t\tfor result in tags:\n\t\t\toList \u003d {}\n\t\t\t\n\t\t\tprovider \u003d str(result[\u0027fullPath\u0027])\n\t\t\toList[\"value\"] \u003d provider\n\t\t\toList[\"label\"] \u003d provider\n\t\t\t\n\t\t\tproviderList.append(oList)\n\t\t\n\t\tsortedProvider \u003d sorted(providerList,key\u003dlambda k: k.get(\u0027value\u0027))\n\t\tsvc.providerSelection \u003d sortedProvider\n\t\tsvc.provider \u003d \"\"\n\n\t\tsvc.output +\u003d \u0027\\n\\r\u0027 + \"Providers Refreshed!\"\n\texcept:\n\t\tsvc.output +\u003d \u0027\\n\\r\u0027 + \"Error: Cannot find any tag providers\"\n\t\tsystem.util.audit(\u0027exportBackup\u0027,\u0027Provider Refrsh\u0027,\"Error: Cannot find any tag providers\")",
