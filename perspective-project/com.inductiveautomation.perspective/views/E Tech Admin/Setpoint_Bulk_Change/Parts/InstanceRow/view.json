{
  "custom": {},
  "params": {
    "label": "",
    "selected": true
  },
  "propConfig": {
    "params.label": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.selected": {
      "paramDirection": "inout",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 30,
      "width": 400
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Checkbox"
        },
        "propConfig": {
          "props.selected": {
            "binding": {
              "config": {
                "bidirectional": true,
                "coalesce": true,
                "path": "view.params.selected"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "margin": "5px"
          },
          "text": "",
          "textPosition": "left"
        },
        "type": "ia.input.checkbox"
      },
      {
        "meta": {
          "name": "Label",
          "tooltip": {
            "enabled": true
          }
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "meta.tooltip.text": {
            "binding": {
              "config": {
                "path": "view.params.label"
              },
              "transforms": [
                {
                  "code": "\treturn str(value).split(\"]\")[0].strip(\u0027[]\u0027)",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.label"
              },
              "transforms": [
                {
                  "code": "\treturn str(value).split(\"]\")[-1]",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "overflow": "auto"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "justify": "space-between"
    },
    "type": "ia.container.flex"
  }
}