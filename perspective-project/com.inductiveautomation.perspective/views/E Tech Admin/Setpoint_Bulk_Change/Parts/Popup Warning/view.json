{
  "custom": {},
  "params": {
    "numInstance": ""
  },
  "propConfig": {
    "params.numInstance": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 300,
      "width": 400
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "Icon"
            },
            "position": {
              "basis": "10%"
            },
            "props": {
              "color": "#D9D900",
              "path": "material/warning"
            },
            "type": "ia.display.icon"
          },
          {
            "meta": {
              "name": "Label"
            },
            "position": {
              "basis": "50%"
            },
            "props": {
              "text": "WARNING!!!",
              "textStyle": {
                "color": "#D90000",
                "fontFamily": "Helvetica",
                "fontSize": 30,
                "textAlign": "center"
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "row_0"
        },
        "position": {
          "basis": "20%"
        },
        "props": {
          "justify": "center"
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "meta": {
              "name": "Label"
            },
            "position": {
              "basis": "100%"
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.numInstance"
                  },
                  "transforms": [
                    {
                      "code": "\tmsg \u003d \u0027\u0027\u0027 You are about to make changes to {} UDT Intances. \n\t\t\tPlease verify and validate the changes you are making. \n\t\t\tThis change will be final and if you need to revert you need to write them over again\u0027\u0027\u0027.format(value)\n\t\t\t\n\treturn msg",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "textStyle": {
                "fontFamily": "Helvetica",
                "fontWeight": "lighter",
                "textAlign": "center"
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "row_1"
        },
        "position": {
          "basis": "45%"
        },
        "props": {
          "style": {
            "padding": 10
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "meta": {
              "name": "Label"
            },
            "position": {
              "basis": "50%"
            },
            "props": {
              "text": "Do you wish to continue?",
              "textStyle": {
                "fontFamily": "Helvetica",
                "fontWeight": "bolder",
                "textAlign": "center"
              }
            },
            "type": "ia.display.label"
          },
          {
            "children": [
              {
                "events": {
                  "component": {
                    "onActionPerformed": {
                      "config": {
                        "script": "\tsystem.perspective.sendMessage(\u0027writeToTags\u0027)\n\tsystem.perspective.closePopup(\"\")"
                      },
                      "scope": "G",
                      "type": "script"
                    }
                  }
                },
                "meta": {
                  "name": "Accept"
                },
                "position": {
                  "basis": "45%"
                },
                "props": {
                  "text": "Accept"
                },
                "type": "ia.input.button"
              },
              {
                "events": {
                  "component": {
                    "onActionPerformed": {
                      "config": {
                        "script": "\tsystem.perspective.closePopup(\"\")"
                      },
                      "scope": "G",
                      "type": "script"
                    }
                  }
                },
                "meta": {
                  "name": "Decline"
                },
                "position": {
                  "basis": "45%"
                },
                "props": {
                  "text": "Decline"
                },
                "type": "ia.input.button"
              }
            ],
            "meta": {
              "name": "Selection"
            },
            "position": {
              "basis": "25%"
            },
            "props": {
              "justify": "space-evenly"
            },
            "type": "ia.container.flex"
          }
        ],
        "meta": {
          "name": "row_2"
        },
        "position": {
          "basis": "40%"
        },
        "props": {
          "direction": "column"
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column"
    },
    "type": "ia.container.flex"
  }
}