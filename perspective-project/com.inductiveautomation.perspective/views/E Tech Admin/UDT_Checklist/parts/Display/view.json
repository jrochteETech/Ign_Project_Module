{
  "custom": {},
  "params": {
    "isLabel": false,
    "label": "",
    "value": ""
  },
  "propConfig": {
    "params.isLabel": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.label": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.value": {
      "paramDirection": "inout",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 46,
      "width": 200
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Label",
          "tooltip": {
            "enabled": true,
            "style": {
              "fontFamily": "Helvetica",
              "fontSize": 12
            }
          }
        },
        "position": {
          "basis": "100%"
        },
        "propConfig": {
          "meta.tooltip.text": {
            "binding": {
              "config": {
                "path": "view.params.value"
              },
              "type": "property"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.isLabel"
              },
              "transforms": [
                {
                  "code": "\tif value:\n\t\tif self.view.params.value !\u003d None:\n\t\t\td \u003d self.view.params.label\n\t\telse:\n\t\t\td \u003d \u0027N/A\u0027\n\telse:\n\t\td \u003d self.view.params.value.split(\u0027/\u0027)[-1]\n\treturn d",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "textStyle": {
            "fontFamily": "Helvetica",
            "fontWeight": "bold",
            "textAlign": "center"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "padding": 5
      }
    },
    "type": "ia.container.flex"
  }
}