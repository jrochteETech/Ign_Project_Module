    "scripts": {
      "customMethods": [
        {
          "name": "findUnusedUDTs",
          "params": [],
          "script": "\tsvc \u003d self.view.custom\n\tsvc.output +\u003d \u0027\\n\\r\u0027 + \"Refreshing All\"\n\tprovider \u003d self.view.custom.provider.strip(\u0027[]\u0027)\n\tquery1 \u003d {\n\t    \"options\": {\n\t        \"includeUdtMembers\": True,\n\t        \"includeUdtDefinitions\": False\n\t    },\n\t    \"condition\": {\n\t        \"tagType\": \"UdtInstance\",\n\t        \"attributes\": {\n\t            \"values\": [],\n\t            \"requireAll\": True\n\t        },\n\t        \"properties\": {\n\t            \"and\": [\n\t                [\n\t                    \"enabled\",\n\t                    \"Equal\",\n\t                    \"true\"\n\t                ]\n\t            ]\n\t        }\n\t    },\n\t    \"returnProperties\": [\n\t        \"typeId\",\n\t        \"tagType\",\n\t        \"enabled\"\n\t    ]\n\t}\n\tresults1 \u003d system.tag.query(provider, query1)\n\t\n\tquery2 \u003d {\n\t    \"options\": {\n\t        \"includeUdtMembers\": False,\n\t        \"includeUdtDefinitions\": True\n\t    },\n\t    \"condition\": {\n\t        \"tagType\": \"UdtType\",\n\t        \"attributes\": {\n\t            \"values\": [],\n\t            \"requireAll\": True\n\t        }\n\t    },\n\t    \"returnProperties\": [\n\t        \"tagType\",\n\t        \"path\"\n\t    ]\n\t}\n\tresults2 \u003d system.tag.query(provider, query2)\n\t\n\t\n\tparent_data_types \u003d list(set(str(result[\u0027typeId\u0027]).replace(\u0027[{}]\u0027.format(provider), \u0027\u0027).replace(\u0027_types_/\u0027, \u0027\u0027) for result in results1))\n\ttagList \u003d []\n\tfor result in parent_data_types:\n\t\toList \u003d {}\n\t\toList[\"label\"] \u003d str(result)\n\t\toList[\"expanded\"] \u003d False\n\t\toList[\"items\"] \u003d []\n\t\t\n\t\ttagList.append(oList)\n\tself.view.custom.usedPaths \u003d sorted(tagList)\n\t\n\t\n\t# Extracting path from results2 and removing provider suffix and \"_types_/\"\n\tpaths \u003d [str(result[\u0027fullPath\u0027]).replace(\u0027[{}]\u0027.format(provider), \u0027\u0027).replace(\u0027_types_/\u0027, \u0027\u0027) for result in results2]\n\ttagList \u003d []\n\tfor result in paths:\n\t\toList \u003d {}\n\t\toList[\"label\"] \u003d str(result)\n\t\toList[\"expanded\"] \u003d False\n\t\toList[\"items\"] \u003d []\n\t\t\n\t\ttagList.append(oList)\n\tself.view.custom.allPaths \u003d sorted(tagList)\n\t\n\t# Finding the difference in data (unused UDT paths)\n\tunused_udt_paths \u003d list(set(paths) - set(parent_data_types))\n\ttagList \u003d []\n\tfor result in unused_udt_paths:\n\t\toList \u003d {}\n\t\toList[\"label\"] \u003d str(result)\n\t\toList[\"expanded\"] \u003d False\n\t\toList[\"items\"] \u003d []\n\t\t\n\t\ttagList.append(oList)\n\tself.view.custom.unusedPaths \u003d sorted(tagList)\n\t\n\tsvc.output +\u003d \u0027\\n\\r\u0027 + \"Complete\"\n#\tself.view.custom.allPaths \u003d sorted(paths)\n#\tself.view.custom.usedPaths \u003d sorted(parent_data_types)\n#\tself.view.custom.unusedPaths \u003d sorted(unused_udt_paths)\n#\treturn sorted(parent_data_types), sorted(paths), sorted(unused_udt_paths)"
        },
        {
          "name": "checkForConfigChild",
          "params": [],
