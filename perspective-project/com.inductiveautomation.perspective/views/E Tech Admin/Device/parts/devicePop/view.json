            "children": [
              {
                "children": [
                  {
                    "meta": {
                      "name": "Markdown"
                    },
                    "position": {
                      "basis": "100%",
                      "grow": 1
                    },
                    "propConfig": {
                      "props.source": {
                        "binding": {
                          "config": {
                            "expression": "\"Name: \" + {view.custom.data.NAME} + \"\\n\\n\" +\r\n\"Enabled: \" + toBoolean({view.custom.data.ENABLED}) + \"\\n\\n\" + \r\n\"Status: \" + {view.custom.data.STATE} + \"\\n\\n\" + \r\n\"Description: \" + {view.custom.data.DESCRIPTION}"
                          },
                          "overlayOptOut": true,
                          "type": "expr"
                        }
                      }
                    },
                    "props": {
                      "style": {
                        "borderStyle": "ridge",
                        "fontWeight": "bold",
                        "margin": 5,
                        "padding": 5,
                        "textAlign": "Left",
                        "textShadow": "#AAAAAA 5px 5px 5px"
                      }
                    },
                    "type": "ia.display.markdown"
                  }
                ],
                "meta": {
                  "name": "FlexContainer"
                },
                "position": {
                  "grow": 1
                },
                "props": {
                  "justify": "center"
                },
                "type": "ia.container.flex"
              },
              {
                "children": [
                  {
                    "custom": {
                      "state": true
                    },
                    "events": {
                      "component": {
                        "onActionPerformed": {
                          "config": {
                            "script": "\n\tdevice \u003d self.view.custom.data.NAME\n\tcurrentlyEnabled \u003d self.view.custom.data.ENABLED\n\tselectedServer \u003d self.view.params.Server\n\tscriptProject \u003d self.view.params.Script_Project\n\tif selectedServer not in [\u0027\u0027,None]:\n\t\tif selectedServer \u003d\u003d system.tag.readBlocking(\u0027[System]Gateway/SystemName\u0027)[0].value:\n\t\t\tdata \u003d system.util.sendRequest(project\u003dscriptProject, messageHandler\u003d\u0027RCEnableDevices\u0027, payload\u003d{\u0027data\u0027:{device:not currentlyEnabled}})\n\t\telse:\n\t\t\tdata \u003d system.util.sendRequest(project\u003dscriptProject, messageHandler\u003d\u0027RCEnableDevices\u0027, payload\u003d{\u0027data\u0027:{device:not currentlyEnabled}}, remoteServer\u003dselectedServer)\n#\t\treturn data"
                          },
                          "scope": "G",
                          "type": "script"
                        }
                      }
                    },
                    "meta": {
                      "name": "Button_0"
                    },
                    "position": {
                      "basis": "34px"
                    },
                    "props": {
                      "primary": false,
                      "text": "Disable/Enable"
                    },
                    "type": "ia.input.button"
                  },
                  {
                    "events": {
                      "component": {
                        "onActionPerformed": {
                          "config": {
                            "script": "\tpayload \u003d {\u0027Hostname\u0027:self.view.custom.data.HOSTNAME,\u0027Port\u0027:502}\n\tselectedServer \u003d self.view.params.Server\n\tscriptProject \u003d self.view.params.Script_Project\n\tif selectedServer not in [\u0027\u0027,None]:\n\t\tif selectedServer \u003d\u003d system.tag.readBlocking(\u0027[System]Gateway/SystemName\u0027)[0].value:\n\t\t\tdata \u003d system.util.sendRequest(project\u003dscriptProject, messageHandler\u003d\u0027RCPingPort\u0027, payload\u003dpayload)\n\t\telse:\n\t\t\tdata \u003d system.util.sendRequest(project\u003dscriptProject, messageHandler\u003d\u0027RCPingPort\u0027, payload\u003dpayload, remoteServer\u003dselectedServer)\n\t\treturn data\n\t"
                          },
                          "scope": "G",
                          "type": "script"
                        }
                      }
                    },
                    "meta": {
                      "name": "Button"
                    },
                    "props": {
                      "primary": false,
                      "text": "Ping Modbus Port From Gateway(502)"
                    },
                    "type": "ia.input.button"
                  },
                  {
                    "events": {
                      "component": {
                        "onActionPerformed": {
                          "config": {
                            "script": "\tpayload \u003d {\u0027Hostname\u0027:self.view.custom.data.HOSTNAME,\u0027Port\u0027:44818}#self.view.custom.data.PORT}\n\tselectedServer \u003d self.view.params.Server\n\tscriptProject \u003d self.view.params.Script_Project\n\tif selectedServer not in [\u0027\u0027,None]:\n\t\tif selectedServer \u003d\u003d system.tag.readBlocking(\u0027[System]Gateway/SystemName\u0027)[0].value:\n\t\t\tdata \u003d system.util.sendRequest(project\u003dscriptProject, messageHandler\u003d\u0027RCPingPort\u0027, payload\u003dpayload)\n\t\telse:\n\t\t\tdata \u003d system.util.sendRequest(project\u003dscriptProject, messageHandler\u003d\u0027RCPingPort\u0027, payload\u003dpayload, remoteServer\u003dselectedServer)\n\t\treturn data"
                          },
                          "scope": "G",
                          "type": "script"
                        }
                      }
