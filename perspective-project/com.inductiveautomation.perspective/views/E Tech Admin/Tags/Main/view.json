          "pageScope": true,
          "script": "\ttry:\n\t\ttags\u003dsystem.tag.browse(filter\u003d{\"tagType\":\"Provider\"}).results\n\t\t\n\t\tproviderList \u003d []\n\t\tfor result in tags:\n\t\t\toList \u003d {}\n\t\t\t\n\t\t\tprovider \u003d str(result[\u0027fullPath\u0027])\n\t\t\toList[\"value\"] \u003d provider\n\t\t\toList[\"label\"] \u003d provider\n\t\t\t\n\t\t\tproviderList.append(oList)\n\t\t\n\t\tsortedProvider \u003d sorted(providerList,key\u003dlambda k: k.get(\u0027value\u0027))\n\t\tself.view.custom.providers \u003d sortedProvider\n\texcept:\n\t\tsystem.util.audit(\u0027Tags\u0027,\u0027Provider Refresh\u0027,\"Error: Cannot find any tag providers\")",
          "sessionScope": false,
          "viewScope": false
        }
